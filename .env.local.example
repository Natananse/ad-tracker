# Local development. Run pnpm run setup to generate the three blank values
# below in .env.local. The Compose database and role are both named starter.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DATABASE_URL=
BETTER_AUTH_SECRET=

# Optional direct (non-pooled) connection for Prisma CLI operations.
# Local setup falls back to the generated DATABASE_URL.
DIRECT_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
EMAIL_SERVER_HOST=127.0.0.1
EMAIL_SERVER_PORT=1025
MAIL_FROM=noreply@localhost.test

# Optional OAuth providers. Supply both fields to enable a provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional integrations used by the selected payment and AI providers.
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# OPENAI_API_KEY=
