{
	"name": "supastarter-nextjs",
	"private": true,
	"scripts": {
		"setup": "bash scripts/setup.sh",
		"build": "dotenv -c -- turbo build",
		"dev": "dotenv -c -- turbo dev --concurrency 15",
		"start": "dotenv -c -- turbo start",
		"lint": "biome lint . ",
		"check": "biome check",
		"clean": "turbo clean",
		"format": "biome format . --write"
	},
	"engines": {
		"node": "^22.13.0 || >=24.0.0"
	},
	"packageManager": "pnpm@10.14.0",
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "^26.6.6",
		"dotenv-cli": "^11.1.0",
		"turbo": "^2.11.13",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@nivo/bar": "^0.99.0",
		"@nivo/heatmap": "^0.99.0",
		"@nivo/line": "^0.99.0",
		"@nivo/pie": "^0.99.0"
	}
}
